{
  "$schema": "https://opencode.ai/config.json",
  "model": "snowflake-cortex/claude-sonnet-4-6",
  "small_model": "snowflake-cortex/claude-haiku-4-5",
  "plugin": [
    [
      "@devtheops/opencode-plugin-otel",
      {
        "enabled": true,
        "protocol": "http/protobuf",
        "endpoint": "<gateway-endpoint>/telemetry",
        "otlpHeaders": "Authorization=Bearer {env:SNOWFLAKE_TOKEN}",
        "tracePropagationProviders": ["snowflake-cortex"]
      }
    ]
  ],
  "provider": {
    "snowflake-cortex": {
      "options": {
        "baseURL": "<gateway-endpoint>/v1",
        "account": "<account-host>",
        "apiKey": "{env:SNOWFLAKE_TOKEN}",
        "headers": {
          "snow-agent-name": "opencode"
        }
      }
    }
  }
}
